# EdTech LMS RPI API Configuration
# Copy this file to .env and fill in your actual values

# RPI API Configuration
FORTYKAPIRPICONFIG={"fortyk":{"api":{"rpi":{"port":3000,"debug":true,"database":{"name":"edtech_lms_rpi","user":"your-db-user","password":"your-db-password","host":"localhost","port":3306}}}}}

# Alternative Environment Variables (if not using FORTYKAPIRPICONFIG)
RPI_PORT=3000
RPI_DB_NAME=edtech_lms_rpi
RPI_DB_USER=your-db-user
RPI_DB_PASSWORD=your-db-password
RPI_DB_HOST=localhost
RPI_DB_PORT=3306

# true on a classroom Pi only. It lets a teacher or admin token load content
# (PUT /import/master); online, only the server sync key can. Leave unset online.
RPI_OFFLINE=

# Application Settings
NODE_ENV=development
LOG_LEVEL=debug

# Set to 1 only behind a reverse proxy that is the sole route in (Caddy on UAT/prod). Leave unset on a Pi.
TRUST_PROXY=

# Server-grading protocol. Leave both unset for the
# safe default: shadow mode, no enforcement.
#
# GRADING_MODE: "enforce" makes a gradable server grade replace the client's
# claimed iscorrect for scoring. Anything else (including unset) is "shadow":
# server grades are computed and stored, but scoring is unchanged.
GRADING_MODE=

# REQUIRE_GRADED_ANSWERS: true/1 makes an unverified quiz/level-quiz/baseline
# result unable to count as a pass. Never rejects old-format results (no
# `answer` field) — they are still accepted, just unverified. Never affects
# practice.
REQUIRE_GRADED_ANSWERS=
